# datasets (download or build them; see README)
/data

# model weights and outputs; only the configs of the released models are tracked
/checkpoints/*
!/checkpoints/vae/
!/checkpoints/prior/
/checkpoints/*/*.pt
!/checkpoints/prior/stats.pt
/checkpoints/*/*/

